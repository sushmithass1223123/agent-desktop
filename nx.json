{
    "npmScope": "agent-desktop",
    "implicitDependencies": {
        "angular.json": "*",
        "package.json": "*",
        "tsconfig.base.json": "*",
        "tslint.json": "*",
        ".eslintrc.json": "*",
        "nx.json": "*"
    },
    "tasksRunnerOptions": {
        "default": {
            "runner": "@nrwl/workspace/tasks-runners/default",
            "options": {}
        }
    },
    "targetDependencies": {
        "build": [
            {
                "target": "build",
                "projects": "dependencies"
            }
        ]
    },
    "defaultProject": "agent-desktop",
    "affected": {
        "defaultBase": "master"
    },
    "targetDefaults": {
        "lint": {
            "cache": true
        },
        "test": {
            "cache": true
        },
        "e2e": {
            "cache": true
        }
    }
}
