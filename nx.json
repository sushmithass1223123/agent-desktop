{
    "npmScope": "agent-desktop",
    "implicitDependencies": {
        "angular.json": "*",
        "package.json": "*",
        "tsconfig.base.json": "*",
        "tslint.json": "*",
        ".eslintrc.json": "*",
        "nx.json": "*"
    },
    "tasksRunnerOptions": {
        "default": {
            "runner": "@nrwl/workspace/tasks-runners/default",
            "options": {
                "cacheableOperations": ["lint", "test", "e2e"]
            }
        }
    },
    "defaultProject": "agent-desktop",
    "affected": {
        "defaultBase": "master"
    }
}
