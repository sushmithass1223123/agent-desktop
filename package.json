{
  "name": "agent-desktop",
  "version": "6.0.0-beta.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl true",
    "start:mem": "node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng serve --open",
    "start:mem:ssl": "node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng serve --open --ssl",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build": "ng build --baseHref=/agent-desktop/",
    "build:prod": "npm run prebuild && ng build --configuration production --base-href=/agent-desktop/",
    "build:prod:stats": "npm run prebuild && ng build --prod --baseHref=/agent-desktop/ --stats-json",
    "build:prod:mem": "npm run prebuild && node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng build --baseHref=/agent-desktop/ --prod",
    "build:serve": "serve dist -l 5000",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "bundle-report": "webpack-bundle-analyzer dist/agent-desktop/stats.json",
    "prebuild": "node ./scripts/pre-build.js && npm run prettify",
    "prettify": "prettier --write ./src/assets/*.json",
    "lint-staged": "lint-staged --config .lintstagedrc"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/localize": "^18.2.13",
    "@angular/material": "^18.2.14",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/service-worker": "^18.2.13",
    "@asymmetrik/ngx-leaflet": "^18.0.1",
    "@azure/msal-angular": "^3.1.0",
    "@ctrl/ngx-emoji-mart": "^9.2.0",
    "@jsverse/transloco": "^7.5.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/microsoft-graph-types": "^2.40.0",
    "@microsoft/teams-js": "^2.32.0",
    "@ngneat/tailwind": "^7.0.3",
    "@progress/kendo-angular-charts": "^17.2.0",
    "@tmac/operators": "git+https://gitlab+deploy-token-40:adUz1ascDCfab1qtKLaz@git.tetherfi.com/tetherfi_product/products/tmac/ui/packages/tmac/operators",
