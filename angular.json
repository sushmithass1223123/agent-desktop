{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "agent-desktop": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser-esbuild",
          "options": {
            "outputPath": "dist/agent-desktop",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "src/polyfills.ts",
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/assets",
              "src/manifest.webmanifest",
              {
                "glob": "**/*",
                "input": "./node_modules/leaflet/dist/images",
                "output": "assets/images/leaflet/"
              },
              
                            {
                                "glob": "**/*",
                                "input": "build-utils/",
                                "output": "/"
                            },
                            {
                                "glob": "**/*",
                                "input": "./node_modules/tinymce/icons",
                                "output": "assets/tinymce/icons/"
                            },{
                              "glob": "**/*",
                              "input": "./node_modules/tinymce/models",
                              "output": "assets/tinymce/models/"
                          },
                          {
                              "glob": "**/*",
                              "input": "./node_modules/tinymce/themes",
                              "output": "assets/tinymce/themes/"
                          },{
                            "glob": "**/*",
                            "input": "./node_modules/tinymce/skins",
                            "output": "assets/tinymce/skins/"
                        },
                        {
                            "glob": "**/*",
                            "input": "./node_modules/tinymce/plugins",
                            "output": "assets/tinymce/plugins/"
                        },
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["./src","./node_modules"]
            },
            "scripts": [],
            "allowedCommonJsDependencies": [
                            "crypto-js",
                            "lodash",
                            "@swimlane/dragula",
                            "chart.js",
                            "angular-calendar",
                            "calendar-utils/date-adapters/date-fns",
                            "contra/emitter",
                            "crossvent",
                            "dom-plane",
                            "dom-set",
                            "rxjs",
                            "@mattlewis92/dom-autoscroller",
                            "chartjs-plugin-piechart-outlabels",
                            "@tmac/operators",
                            "@microsoft/microsoft-graph-client/authProviders/authCodeMsalBrowser",
                            "moment",
                            "leaflet",
                            "hammerjs",
                            "tinymce"
                        ]
                        
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                  {
                      "replace": "src/environments/environment.ts",
                      "with": "src/environments/environment.prod.ts"
                  }
              ],
              "optimization": {
                  "scripts": true,
                  "fonts": {
                      "inline": true
                  },
                  "styles": {
                      "minify": true,
                      "inlineCritical": false
                  }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10MB",
                  "maximumError": "11MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "1MB"
                }
              ],
              "outputHashing": "all",
              "sourceMap": true,
              "buildOptimizer": true,
              "vendorChunk": true,
              "aot": true,
              "serviceWorker": true
            },
            "development": {
              "buildOptimizer": false,
              "optimization": true,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "none"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "agent-desktop:build:production"
            },
            "development": {
              "buildTarget": "agent-desktop:build:development",
              "proxyConfig": "src/proxy.conf.json"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "src/proxy.conf.json"
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "agent-desktop:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing",
              "src/polyfills.ts",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          }
        },
        "e2e": {
            "builder": "@angular-devkit/build-angular:protractor",
            "options": {
                "protractorConfig": "e2e/protractor.conf.js",
                "devServerTarget": "agent-desktop:serve"
            },
            "configurations": {
                "production": {
                    "devServerTarget": "agent-desktop:serve:production"
                }
            }
         }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
