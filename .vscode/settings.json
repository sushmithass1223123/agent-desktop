{
    "search.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/documentation": true,
        "**/bower_components": true,
        "**/tmp": true,
        "**/build-utils": true,
        "**/dist": true
    },
    "typescript.tsdk": "node_modules\\typescript\\lib",
    "angular.enable-strict-mode-prompt": false,
    "commit-message-editor.dynamicTemplate": ["{type}({scope}): {description}", "", "{body}", "", "{breaking_change}{footer}"],
    "commit-message-editor.tokens": [
        {
            "label": "Type",
            "name": "type",
            "type": "enum",
            "options": [
                {
                    "label": "---",
                    "value": ""
                },
                {
                    "label": "✨ feat",
                    "description": "A new feature",
                    "value": ":sparkles: feat"
                },
                {
                    "label": "🐛 fix",
                    "description": "A bug fix",
                    "value": ":bug: fix"
                },
                {
                    "label": "📦 build",
                    "description": "New build",
                    "value": ":package: build"
                },
                {
                    "label": "🚚 chore",
                    "description": "General changes",
                    "value": ":truck: chore"
                },
                {
                    "label": "📝 docs",
                    "description": "Documentation only changes",
                    "value": ":memo: docs"
                },
                {
                    "label": "🔧 config",
                    "description": "Add or update configuration files",
                    "value": ":wrench: config"
                },
                {
                    "label": "⚡️ perf",
                    "description": "A code change that improves performance",
                    "value": ":zap: perf"
                },
                {
                    "label": "♻️ refactor",
                    "description": "A code change that neither fixes a bug nor adds a feature",
                    "value": ":recycle: refactor"
                },
                {
                    "label": "🎨 style",
                    "description": "Changes that do not affect the meaning of the code (white-space, formatting, missing semi-colons, etc)",
                    "value": ":art: style"
                },
                {
                    "label": "🔍 test",
                    "description": "Adding missing tests or correcting existing tests",
                    "value": ":mag: test"
                }
            ],
            "description": "Type of changes"
        },
        {
            "label": "Scope",
            "name": "scope",
            "description": "A scope may be provided to a commit’s type, to provide additional contextual information and is contained within parenthesis, e.g., \"feat(parser): add ability to parse arrays\".",
            "type": "text",
            "multiline": false,
            "prefix": "",
            "suffix": ""
        },
        {
            "label": "Short description",
            "name": "description",
            "description": "Short description in the subject line.",
            "type": "text",
            "multiline": false
        },
        {
            "label": "Body",
            "name": "body",
            "description": "Optional body",
            "type": "text",
            "multiline": true,
            "lines": 5,
            "maxLines": 10
        },
        {
            "label": "Breaking change",
            "name": "breaking_change",
            "type": "boolean",
            "value": "BREAKING CHANGE: ",
            "default": false
        },
        {
            "label": "Footer",
            "name": "footer",
            "description": "Optional footer",
            "type": "text",
            "multiline": true
        }
    ],
    "commit-message-editor.view.defaultView": "form",
    "nxConsole.generateAiAgentRules": true
}
